{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|Read|Grep|WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ABSOLUTE-PATH-TO>/REVATHI/adapters/claude-code/hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ABSOLUTE-PATH-TO>/REVATHI/adapters/claude-code/hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ABSOLUTE-PATH-TO>/REVATHI/adapters/claude-code/hook.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"<ABSOLUTE-PATH-TO>/REVATHI/adapters/claude-code/hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
